  ],
  "files": [
   "src/levels/port-of-victory/director.js"
  ]
 },
 {
  "key": "d0702a42",
  "text": "Crane operator's fired. HR is gonna love that.",
  "levels": [
   "port-of-victory"
  ],
  "files": [
   "src/levels/port-of-victory/director.js"
  ]
 },
 {
  "key": "3088af27",
  "text": "Forklift! Forklift full of fuel drums! Of course!",
  "levels": [
   "port-of-victory"
  ],
  "files": [
   "src/levels/port-of-victory/director.js"
  ]
 },
 {
  "key": "589f624f",
  "text": "...I have never seen a forklift do that.",
  "levels": [
   "port-of-victory"
  ],
  "files": [
   "src/levels/port-of-victory/director.js"
  ]
 },
 {
  "key": "30d98d6c",
  "text": "That's her. Up the gangway — the fuel hold is mid-ship.",
  "levels": [
   "port-of-victory"
  ],
  "files": [
   "src/levels/port-of-victory/director.js"
  ]
 },
 {
  "key": "714d67b8",
  "text": "Red valves, mid-deck. Light it up!",
  "levels": [
   "port-of-victory"
  ],
  "files": [
   "src/levels/port-of-victory/director.js"
  ]
 },
 {
  "key": "71b4c39d",
  "text": "She's gonna blow! Get off the ship! RUN!!",
  "levels": [
   "port-of-victory"
  ],
  "files": [
   "src/levels/port-of-victory/director.js"
  ]
 },
 {
  "key": "dcdf0a7e",
  "text": "...Was that our boat?",
  "levels": [
   "port-of-victory"
  ],
  "files": [
   "src/levels/port-of-victory/director.js"
  ]
 },
 {
  "key": "180a9267",
  "text": "We'll take the next one.",
  "levels": [
   "port-of-victory"
  ],
  "files": [
   "src/levels/port-of-victory/director.js"
  ]
 },
 {
  "key": "30e2ab38",
  "text": "Get up! I'm not explaining this to your mom!",
  "levels": [
   "port-of-victory"
  ],
  "files": [
   "src/levels/port-of-victory/game.js"
  ]
 },
 {
  "key": "b03df6a9",
  "text": "You don't get to die on a Tuesday!",
  "levels": [
   "port-of-victory"
  ],
  "files": [
   "src/levels/port-of-victory/game.js"
  ]
 },
 {
  "key": "76c768b6",
  "text": "Black SUVs, six o'clock. Get on the gun!",
  "levels": [
   "the-405-job"
  ],
  "files": [
   "src/levels/the-405-job/director.js"
  ]
 },
 {
  "key": "961f4865",
  "text": "Woo! That one had a sunroof!",
  "levels": [
   "the-405-job"
  ],
  "files": [
   "src/levels/the-405-job/director.js"
  ]
 },
 {
  "key": "738dbcfb",
  "text": "Nice! Reload, more coming!",
  "levels": [
   "the-405-job"
  ],
  "files": [
   "src/levels/the-405-job/director.js"
  ]
 },
 {
  "key": "fc4b87c2",
  "text": "One coming back from ahead — eyes front!",
  "levels": [
   "the-405-job"
  ],
  "files": [
   "src/levels/the-405-job/director.js"
  ]
 },
 {
  "key": "89cd055a",
  "text": "Is that a fuel tanker? Don't you dare...",
  "levels": [
   "the-405-job"
  ],
  "files": [
   "src/levels/the-405-job/director.js"
  ]
 },
 {
  "key": "f9989b9d",
  "text": "You did. You absolutely did.",
  "levels": [
   "the-405-job"
  ],
  "files": [
   "src/levels/the-405-job/director.js"
  ]
 },
 {
  "key": "8b07ceb5",
  "text": "Four more! They're gonna try to box us in!",
  "levels": [
   "the-405-job"
  ],
  "files": [
   "src/levels/the-405-job/director.js"
  ]
 },
 {
  "key": "c3ac55b7",
  "text": "Is that... rotor noise?",
  "levels": [
   "the-405-job"
  ],
  "files": [
   "src/levels/the-405-job/director.js"
  ]
 },
 {
  "key": "b9dbd1a7",
  "text": "It called friends!",
  "levels": [
   "the-405-job"
  ],
  "files": [
   "src/levels/the-405-job/director.js"
  ]
 },
 {
  "key": "b900ccb2",
  "text": "...We should really get this truck washed.",
  "levels": [
   "the-405-job"
  ],
  "files": [
   "src/levels/the-405-job/director.js"
  ]
 },
 {
  "key": "b5b32476",
  "text": "Stay with me! You don't get to die before the credits!",
  "levels": [
   "the-405-job"
  ],
  "files": [
   "src/levels/the-405-job/game.js"
  ]
 },
 {
  "key": "e65340bf",
  "text": "It's going down — it's going down ON US!",
  "levels": [
   "the-405-job"
  ],
  "files": [
   "src/levels/the-405-job/game.js"
  ]
 },
 {
  "key": "a3df61e6",
  "text": "He's gonna ram us!",
  "levels": [
   "the-405-job"
  ],
  "files": [
   "src/levels/the-405-job/game.js"
  ]
 },
 {
  "key": "87990b23",
  "text": "Helicopter! Why is it ALWAYS a helicopter?!",
  "levels": [
   "the-405-job"
  ],
  "files": [
   "src/levels/the-405-job/game.js"
  ]
 },
 {
  "key": "c1b82a13",
  "text": "Red dot! Up on the screens — the catwalk!",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "95efa8e5",
  "text": "Sniper on the big screen catwalk! Don't let the dot settle on you!",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "83da6965",
  "text": "Even the taxis explode. Of course they do.",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "04860bb3",
  "text": "Sniper down! Good. That one was ruining the ads.",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "68432d60",
  "text": "You shot the cola ad. Somewhere a marketing guy just felt that.",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "327a581f",
  "text": "It's leaking! Hit it again!",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "f2494f84",
  "text": "Kurogane. Three in the afternoon. Busiest crossing on Earth, and not one tourist. That's how you know.",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "095328ec",
  "text": "Our guy's on the far side of the crossing. His friends are between you and him. Down the stairs.",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "02d82173",
  "text": "Plaza first. Then the crossing — the cars are your cover.",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "3f865fcd",
  "text": "...Every screen in Kurogane just went to emergency broadcast. Subtle.",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "d9e60d77",
  "text": "Station east exit, on your left. The expressway ramp is up past the decks — they're waiting on them.",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "36ef17dc",
  "text": "Another dot — across the avenue, on the roof!",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "93fc9952",
  "text": "Look up! They're on the walkways — every bridge over the plaza.",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "6209a1fe",
  "text": "Stairs at the east end take you up onto the deck.",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "3a72c0a2",
  "text": "Up the stairs. Station terrace at the top, then the link onto the expressway.",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "1b563d81",
  "text": "Shuto expressway, jammed solid both ways. Duck between the cars and keep going west.",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "1e607600",
  "text": "Roof across the road — red dot, north side!",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "0d38634d",
  "text": "That's a fuel tanker. In the middle of a jam. On a bridge. ...Yeah, you know what to do.",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "90bf0be4",
  "text": "The TANKER! Shoot the tanker!",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "aeb406cf",
  "text": "...She's going— the WHOLE SPAN is going—",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "4c902682",
  "text": "...You dropped a piece of expressway on a street. In Tokyo. They will never let me drive here again.",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "29e97ff7",
  "text": "Center-gai. Watch the shops — they love a doorway.",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "4423bdff",
  "text": "Smell that? The fuel off that tanker's running into the drains...",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "cd300485",
  "text": "Wait— that's gas. The fuel's in the gas main. LOOK — back up the street!",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "fb2c255c",
  "text": "RUN! RUN! OUT TO THE CROSSING!",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "8e58ed48",
  "text": "Keep going! It's right behind you!",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "d3f1c54c",
  "text": "GET DOWN!",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "a45bd276",
  "text": "...Okay. Okay. You're alive. The street isn't.",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/director.js"
  ]
 },
 {
  "key": "9aa3ee5c",
  "text": "Get up! Tokyo's not done with you!",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/game.js"
  ]
 },
 {
  "key": "ba12321d",
  "text": "Don't you dare die in a karaoke district!",
  "levels": [
   "tokyo-scramble"
  ],
  "files": [
   "src/levels/tokyo-scramble/game.js"
  ]
 }
]